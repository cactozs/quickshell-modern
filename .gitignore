# matugen-generated palette (rewritten on every `matugen image` / `awww img`)
style/Colors*.json

# quickshell LSP scratch file (auto-filled with session-specific VFS paths)
.qmlls.ini

# app color target toggles (quick settings)
theme-apps.json

# bar style setting (quick settings)
bar.json

# launcher launch counts (sort order)
services/LauncherCounts.json

# zcode session artifacts
.zcode/
